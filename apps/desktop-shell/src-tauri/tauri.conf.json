{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Assistant Hub AI — Shell",
  "version": "0.1.0",
  "identifier": "ai.assistanthub.desktopshell",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "features": ["gui"]
  },
  "app": {
    "windows": [
      {
        "title": "Assistant Hub AI — Shell",
        "width": 1024,
        "height": 768,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": ["msi", "nsis"],
    "windows": {}
  }
}
