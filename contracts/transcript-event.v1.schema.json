{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assistanthub.ai/schemas/transcript-event.v1.schema.json",
  "title": "Assistant Hub transcript event v1",
  "type": "object",
  "required": ["type", "sessionId", "source", "text", "latencyMs", "occurredAt"],
  "properties": {
    "type": {"enum": ["transcript.partial.v1", "transcript.final.v1"]},
    "sessionId": {"type": "string", "minLength": 1},
    "source": {"enum": ["system", "microphone"]},
    "text": {"type": "string"},
    "language": {"type": ["string", "null"]},
    "languageProbability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "latencyMs": {"type": "integer", "minimum": 0},
    "audioSeconds": {"type": "number", "minimum": 0},
    "droppedWindows": {"type": "integer", "minimum": 0},
    "occurredAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
