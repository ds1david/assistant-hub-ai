# Assistant Hub AI - transcription defaults for NVIDIA GPU in WSL/Docker Desktop
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=pt
WHISPER_BEAM_SIZE=5
WHISPER_PATIENCE=1.0
WHISPER_TEMPERATURE=0.0
WHISPER_REPETITION_PENALTY=1.05
WHISPER_NO_SPEECH_THRESHOLD=0.55
WHISPER_INITIAL_PROMPT=Transcrição em português do Brasil. Preserve termos técnicos, nomes próprios, siglas, gírias e palavras coloquiais exatamente como foram pronunciadas.
WHISPER_HOTWORDS=
WHISPER_HOTWORDS_FILE=/config/whisper-hotwords.txt
WHISPER_WINDOW_SECONDS=3.2
WHISPER_OVERLAP_SECONDS=0.8
WHISPER_MIN_AUDIO_SECONDS=0.8
WHISPER_VAD_MIN_SILENCE_MS=350

# Remove no feed a transcrição duplicada que vaza dos alto-falantes para o microfone.
ECHO_SUPPRESSION_ENABLED=true
ECHO_SUPPRESSION_WINDOW_SECONDS=5.0
ECHO_SUPPRESSION_SIMILARITY=0.82
ECHO_SUPPRESSION_MIN_CHARS=5
ECHO_SUPPRESSION_MIC_DELAY_MS=450

# Métricas de latência em memória (p50/p95 por canal em /v1/sessions/{sessionId}/metrics).
METRICS_MAX_SAMPLES_PER_CHANNEL=512
METRICS_MAX_CHANNELS=64

# Texto consolidado em memória (sem duplicação de overlap em /v1/sessions/{sessionId}/transcript).
TRANSCRIPT_MAX_SEGMENTS_PER_CHANNEL=256
TRANSCRIPT_MAX_CHANNELS=64
TRANSCRIPT_OVERLAP_TAIL_WORDS=12

MODEL_CACHE_DIR=/models
LOG_LEVEL=INFO

HF_TOKEN=

# session-core (Compose). Host port mapped to container :8080.
SESSION_CORE_PORT=8080
# Feed URL seen from inside the session-core container (Compose DNS).
SESSION_CORE_TRANSCRIPT_FEED_URL=ws://transcription:8001/ws/transcripts
SESSION_CORE_MEMORY_HUB_PATH=/data/session-core/memory-hub.db
SESSION_CORE_AI_PROVIDER_HUB_PATH=/config/ai-providers.yaml

# AI Provider Hub secrets (secretRef env:VAR in config/ai-providers.yaml).
# AI_SECRETS_BACKEND=env
# NVIDIA_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
